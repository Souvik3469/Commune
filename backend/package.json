{
  "name": "commune-backend",
  "version": "1.0.0",
  "description": "commune-backend",
  "main": "src/app.js",
  "scripts": {
    "backup:sandbox": "npm run build && node build/v1/scripts/sandboxBackup.js",
    "build": "babel src -s -d build --copy-files",
    "dev": "nodemon --exec babel-node src/app.js",
    "lint": "eslint src --ext .js",
    "lint-fix": "eslint src --ext .js --fix",
    "migrate:cleanup": "npm run build && node build/v1/scripts/prePushCleanup.js",
    "restore:sandbox": "npm run build && node build/v1/scripts/sandboxRestore.js",
    "sandbox:backup": "npm run build && node build/v1/backup/backupSandboxUsers.js",
    "start": "npm run build && node build/app.js",
    "test": "npm run build && node --test test/"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "otp-generator": "^4.0.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.19.3",
    "@babel/core": "^7.20.5",
    "@babel/node": "^7.20.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "eslint": "^8.29.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "nodemon": "^2.0.20",
    "prisma": "^5.17.0"
  }
}
