{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": [
    "eslint:recommended"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^(next|_)",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": "off"
  },
  "ignorePatterns": [
    "build/",
    "node_modules/"
  ]
}
